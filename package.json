{
  "name": "pano",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --max-warnings 0",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "deploy:review": "node scripts/deploy-review.mjs",
    "setup:review": "node scripts/setup-review.mjs",
    "check:release": "node scripts/check-release.mjs",
    "verify": "npm run build && npm run lint && npm test && npm run check:release",
    "verify:reproducible": "node scripts/verify-reproducible.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.17",
    "esbuild": "^0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "obsidian": "latest",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1"
  }
}
